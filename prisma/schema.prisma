generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  // Used only to generate TypeScript types; the app stores its data in Microsoft Access.
  provider = "sqlite"
  url      = "file:./unused.db"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  name      String
  password  String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  orderReturns OrderReturn[]
}

model Product {
  id            String              @id @default(cuid())
  code          String
  barcode       String?
  name          String
  type          String
  gauge         String?
  size          String
  color         String?
  length        String?
  weight        String?
  pricePerKilo  Float?              @default(0)
  costPrice     Float               @default(0)
  markup        Float               @default(1.3)
  price         Float
  taxRate       Float               @default(0.14)
  stockQty      Int                 @default(0)
  reservedQty   Int                 @default(0)
  minStockQty   Int                 @default(10)
  maxStockQty   Int                 @default(1000)
  supplierId    String?
  imageUrl      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  orderItems    OrderItem[]
  orderReturnItems OrderReturnItem[]
  purchaseItems PurchaseOrderItem[]
  customPrices  CustomerPrice[]
  ceilingQuotas CustomerCeilingQuota[]
  supplierPrices SupplierPrice[]
  stocktakeItems StocktakeItem[]
  distributionItems DistributionItem[]
  supplier Supplier?           @relation(fields: [supplierId], references: [id])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
}

model BankTransfer {
  id                  String   @id @default(cuid())
  transferNumber      String   @unique
  requestId           String   @unique
  fromBankId          String
  toBankId            String
  fromBankName        String
  toBankName          String
  fromAccountNumber   String?
  toAccountNumber     String?
  amount              Float
  date                DateTime
  reference           String?
  notes               String?
  status              String   @default("POSTED")
  reversalOf          String?
  createdBy           String
  createdByName       String
  fromBalanceBefore   Float
  fromBalanceAfter    Float
  toBalanceBefore     Float
  toBalanceAfter      Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ProductOption {
  id        String   @id @default(cuid())
  kind      String
  value     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, value])
}

model StocktakeSetting {
  id           String   @id @default(cuid())
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Stocktake {
  id             String   @id @default(cuid())
  documentNumber String   @unique
  status         String   @default("DRAFT")
  notes          String?
  revision       Int      @default(1)
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          StocktakeItem[]
}

model StocktakeItem {
  id           String   @id @default(cuid())
  stocktakeId  String
  productId    String
  position     Int
  productLabel String
  bookQty      Int
  countedQty   Int?
  unitCost     Float?
  stocktake    Stocktake @relation(fields: [stocktakeId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])
  @@unique([stocktakeId, productId])
}

model Order {
  id            String      @id @default(cuid())
  invoiceNumber String      @unique
  isQuotation   Boolean     @default(false)
  customerName  String?
  customerId    String?
  totalAmount   Float
  taxAmount     Float
  netAmount     Float
  qrCode            String?
  siteReceiptNumber String?
  receiverName      String?
  purchaseOrderNumber String?
  invoiceType       String      @default("فاتورة ضريبية")
  status            String      @default("COMPLETED")
  userId            String
  createdAt         DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customer      Customer?   @relation(fields: [customerId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  items         OrderItem[]
  orderReturns  OrderReturn[]
  distributionInvoice DistributionInvoice?
}

model Customer {
  id             String    @id @default(cuid())
  name           String    @unique
  location       String?
  buildingsCount Int       @default(0)
  cr             String?
  trn            String?
  customerType   String    @default("CASH")
  phone          String?
  discount       Float     @default(0)
  openingBalance Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
  orderReturns   OrderReturn[]
  payments       Payment[]
  discounts      AccountDiscount[]
  customPrices   CustomerPrice[]
  ceilingQuotas  CustomerCeilingQuota[]
  distributions Distribution[]
}

model CustomerPrice {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  position  Int?
  quantity  Int
  unitPrice Float
  taxAmount Float
  total     Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnItems OrderReturnItem[]
  distributionInvoiceItems DistributionInvoiceItem[]
}

model Distribution {
  id          String   @id @default(cuid())
  documentNumber String @unique
  customerId  String
  customerName String
  status      String   @default("DRAFT")
  notes       String?
  revision    Int      @default(1)
  createdBy   String
  updatedBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    Customer @relation(fields: [customerId], references: [id])
  items       DistributionItem[]
  revisions   DistributionRevision[]
  dispatches  DistributionDispatch[]
  invoiceItems DistributionInvoiceItem[]
}

model DistributionItem {
  id             String   @id @default(cuid())
  distributionId String
  productId      String
  position       Int
  productLabel   String
  quantity       Int
  shippedQuantity Int    @default(0)
  invoicedQuantity Int   @default(0)
  unitPrice      Float
  taxRate        Float
  isCancelled    Boolean @default(false)
  distribution   Distribution @relation(fields: [distributionId], references: [id])
  product        Product @relation(fields: [productId], references: [id])
  dispatchItems  DistributionDispatchItem[]
  invoiceItems   DistributionInvoiceItem[]
  @@unique([distributionId, productId])
}

model DistributionRevision {
  id             String   @id @default(cuid())
  distributionId String
  revision       Int
  action         String
  performedBy    String
  beforeSnapshot String?
  afterSnapshot  String
  createdAt      DateTime @default(now())
  distribution   Distribution @relation(fields: [distributionId], references: [id])
  @@unique([distributionId, revision])
}

model DistributionDispatch {
  id             String   @id @default(cuid())
  dispatchNumber String   @unique
  distributionId String
  notes          String?
  createdBy      String
  dispatchedAt   DateTime
  createdAt      DateTime @default(now())
  distribution   Distribution @relation(fields: [distributionId], references: [id])
  items          DistributionDispatchItem[]
}

model DistributionDispatchItem {
  id                    String   @id @default(cuid())
  dispatchId            String
  distributionItemId    String
  quantity              Int
  dispatch              DistributionDispatch @relation(fields: [dispatchId], references: [id])
  distributionItem      DistributionItem @relation(fields: [distributionItemId], references: [id])
}

model DistributionInvoice {
  id          String   @id @default(cuid())
  requestId   String   @unique
  requestSnapshot String
  orderId     String   @unique
  customerId  String
  customerName String
  createdBy   String
  createdAt   DateTime @default(now())
  order       Order @relation(fields: [orderId], references: [id])
  items       DistributionInvoiceItem[]
}

model DistributionInvoiceItem {
  id                    String   @id @default(cuid())
  distributionInvoiceId String
  distributionId        String
  distributionItemId    String
  orderItemId           String   @unique
  quantity              Int
  invoice               DistributionInvoice @relation(fields: [distributionInvoiceId], references: [id])
  distribution          Distribution @relation(fields: [distributionId], references: [id])
  distributionItem      DistributionItem @relation(fields: [distributionItemId], references: [id])
  orderItem             OrderItem @relation(fields: [orderItemId], references: [id])
}

model OrderReturn {
  id           String            @id @default(cuid())
  returnNumber String            @unique
  orderId      String
  customerId   String?
  userId       String?
  totalAmount  Float
  taxAmount    Float
  netAmount    Float
  refundAmount Float             @default(0)
  refundMethod String            @default("NONE")
  bankId       String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  order        Order             @relation(fields: [orderId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  user         User?             @relation(fields: [userId], references: [id])
  bank         Bank?             @relation(fields: [bankId], references: [id])
  items        OrderReturnItem[]
}

model OrderReturnItem {
  id            String      @id @default(cuid())
  orderReturnId String
  orderItemId   String
  productId     String
  quantity      Int
  unitPrice     Float
  taxAmount     Float
  total         Float
  orderReturn   OrderReturn @relation(fields: [orderReturnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
}

model Bank {
  id            String           @id @default(cuid())
  name          String           @unique
  accountNumber String?
  balance       Float            @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  expenses        ExpensePayment[]
  payments        Payment[]
  generalExpenses GeneralExpense[]
  orderReturns    OrderReturn[]
}

model SupplierPrice {
  id        String   @id @default(cuid())
  supplierId String
  productId String
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
}

model CustomerCeilingQuota {
  id               String   @id @default(cuid())
  customerId       String
  productId        String
  buildingsCount   Int
  floorsCount      Int      @default(6)
  quantityPerFloor Int
  totalQuantity    Int
  deliveredQuantity Int     @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
}

model Payment {
  id            String   @id @default(cuid())
  customerId    String
  bankId        String
  amount        Float
  reference     String?
  receiptNumber String?
  date          DateTime @default(now())
  notes         String?
  correctionHistory String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bank          Bank     @relation(fields: [bankId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
}

model Supplier {
  id             String           @id @default(cuid())
  name           String           @unique
  phone          String?
  address        String?
  cr             String?
  trn            String?
  balance        Float            @default(0)
  openingBalance Float            @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  expenses       ExpensePayment[]
  purchaseOrders PurchaseOrder[]
  products       Product[]
  discounts      AccountDiscount[]
  supplierPrices SupplierPrice[]
}

model AccountDiscount {
  id             String    @id @default(cuid())
  discountNumber String    @unique
  requestId      String    @unique
  kind           String
  customerId     String?
  supplierId     String?
  amount         Float
  date           DateTime  @default(now())
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer? @relation(fields: [customerId], references: [id])
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  billNumber  String              @unique
  warehouseReceiptNumber String?
  supplierId  String
  invoiceType String              @default("فاتورة ضريبية")
  totalAmount Float
  taxAmount   Float
  netAmount   Float
  date        DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  items       PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Float
  taxAmount       Float
  total           Float
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model ExpensePayment {
  id            String   @id @default(cuid())
  expenseNumber String   @unique
  supplierId    String
  bankId        String
  amount        Float
  reference     String?
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bank          Bank     @relation(fields: [bankId], references: [id])
  supplier      Supplier @relation(fields: [supplierId], references: [id])
}

model ExpenseCategory {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  expenses  GeneralExpense[]
}

model GeneralExpense {
  id            String          @id @default(cuid())
  expenseNumber String          @unique
  bankId        String
  categoryId    String
  amount        Float
  reference     String?
  date          DateTime        @default(now())
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bank          Bank            @relation(fields: [bankId], references: [id])
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
}
