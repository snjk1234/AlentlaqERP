{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?\\/api(?:\\/((?:[^\\/#\\?]+?)(?:\\/(?:[^\\/#\\?]+?))*))?(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/api/:path*"
        }
      ]
    },
    "/api/bank-transfers": {},
    "/api/db": {},
    "/api/invoice-details": {},
    "/api/product-options": {},
    "/api/production-reset": {},
    "/api/quotation-costs": {},
    "/api/stocktakes": {}
  }
}