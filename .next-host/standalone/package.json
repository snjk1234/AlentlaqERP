{
  "name": "pos-app",
  "version": "2.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "electron-dev": "electron .",
    "build": "next build",
    "build:electron": "node scripts/build.js",
    "package": "npm run build:electron && electron-builder",
    "start": "next start",
    "start:host": "node scripts/start-access-server.js",
    "package:host": "node scripts/package-host.js",
    "lint": "eslint"
  },
  "build": {
    "appId": "com.alentlaq.pos",
    "productName": "AlEntlaqPOS",
    "directories": {
      "output": "dist-v20"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "src/lib/remote-client.js",
      "src/lib/payment-corrections.js",
      "src/lib/document-edits.js",
      "src/lib/bank-statement.js",
      "src/lib/customer-prices.js",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/src/generated/client/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "odbc": "^2.6.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss-rtl": "^0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^5.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.1.0"
  },
  "pnpm": {
    "approvedBuilds": [
      "@prisma/client",
      "@prisma/engines",
      "electron-winstaller",
      "odbc",
      "prisma",
      "sharp"
    ]
  }
}
