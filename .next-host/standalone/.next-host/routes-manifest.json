{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/customers/[id]/ceilings",
      "regex": "^/api/customers/([^/]+?)/ceilings(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/customers/(?<nxtPid>[^/]+?)/ceilings(?:/)?$"
    },
    {
      "page": "/api/customers/[id]/ceilings/[quotaId]",
      "regex": "^/api/customers/([^/]+?)/ceilings/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPquotaId": "nxtPquotaId"
      },
      "namedRegex": "^/api/customers/(?<nxtPid>[^/]+?)/ceilings/(?<nxtPquotaId>[^/]+?)(?:/)?$"
    },
